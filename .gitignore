:root {
  --bg: #06090f;
  --panel: #f3f0f5;
  --purple: #6d2ef2;
  --purple-dark: #4a0dc4;
  --text: #1f1b2d;
  --muted: #6f6a7c;
  --shadow: rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
}

button {
  font: inherit;
  border: none;
  background: transparent;
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

.page-shell {
  min-height: 100vh;
  background: #04070d;
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: 18px 24px 40px;
}

.topbar {
  width: min(100%, 1000px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  margin-bottom: 10px;
}

.icon-button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #f4f4f4;
  font-size: 1.8rem;
  line-height: 1;
  background: rgba(255, 255, 255, 0.08);
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.app-stage {
  width: min(100%, 1100px);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 38px;
  margin-top: 12px;
}

.phone-mockup {
  width: min(100%, 420px);
  min-height: 760px;
  background: #0d1118;
  border-radius: 44px;
  padding: 14px 12px 16px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.phone-inner {
  background: linear-gradient(180deg, #faf6fb 0%, #f1edf2 100%);
  border-radius: 34px;
  height: 100%;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.phone-header {
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  color: var(--text);
  font-size: 0.85rem;
  font-weight: 700;
}

.signal-group {
  display: flex;
  align-items: end;
  gap: 3px;
  height: 14px;
}

.signal {
  width: 4px;
  border-radius: 2px 2px 0 0;
  background: #1d1d1d;
  display: inline-block;
}

.signal:nth-child(1) { height: 5px; }
.signal:nth-child(2) { height: 8px; }
.signal:nth-child(3) { height: 11px; }

.battery {
  display: inline-block;
  width: 22px;
  height: 10px;
  border-radius: 3px;
  border: 2px solid #1d1d1d;
  position: relative;
  background: linear-gradient(90deg, #1d1d1d 0 80%, transparent 80%);
}

.battery::after {
  content: '';
  position: absolute;
  top: 2px;
  right: -4px;
  width: 2px;
  height: 4px;
  background: #1d1d1d;
  border-radius: 1px;
}

.brand-block {
  padding: 12px 24px 0;
}

.brand-block h1 {
  margin: 0;
  color: #5d28f5;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -0.06em;
  text-align: center;
}

.hero-card {
  margin: 12px 18px 0;
  padding: 10px 14px 10px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.32);
  box-shadow: inset 0 0 0 1px rgba(95, 61, 141, 0.06);
}

.creator-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  text-align: center;
  padding: 4px 8px 8px;
}

.creator-badge {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--purple);
  color: white;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
}

.creator-info h2 {
  margin: 0;
  font-size: clamp(1.8rem, 2.3vw, 3rem);
  line-height: 1;
  letter-spacing: -0.06em;
  color: var(--purple);
  font-weight: 900;
}

.creator-info p {
  margin: 6px 0 0;
  font-size: 0.74rem;
  color: #3f3d46;
  opacity: 0.8;
  text-align: center;
}

.tab-nav {
  display: flex;
  justify-content: center;
  gap: 28px;
  margin-top: 18px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(84, 54, 120, 0.18);
}

.tab-nav button {
  font-size: 1.12rem;
  font-weight: 700;
  color: #6a5b7d;
  padding: 8px 0 10px;
  position: relative;
}

.tab-nav button.active {
  color: #1f1a2d;
}

.tab-nav button.active::after {
  content: '';
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: -1px;
  height: 3px;
  border-radius: 10px;
  background: linear-gradient(90deg, var(--purple) 0%, #7b3bf4 100%);
}

.media-panel {
  position: relative;
  margin-top: 10px;
  border-radius: 18px;
  overflow: hidden;
  background: #dfe5ee;
  height: 470px;
  box-shadow: 0 16px 28px rgba(37, 28, 49, 0.18);
}

.media-panel img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.portrait-bubble {
  position: absolute;
  left: 50%;
  bottom: -14px;
  transform: translateX(-50%);
  width: 200px;
  height: 200px;
  border-radius: 50%;
  overflow: hidden;
  border: 6px solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 14px 24px rgba(0, 0, 0, 0.22);
}

.portrait-bubble img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.9) contrast(1.05);
}

.engagement-panel {
  position: absolute;
  right: 12px;
  top: 40%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  z-index: 2;
}

.engagement-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  color: white;
  text-shadow: 0 2px 5px rgba(0, 0, 0, 0.4);
}

.engagement-item .icon {
  width: 42px;
  height: 42px;
  background: rgba(113, 43, 219, 0.85);
  border-radius: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  box-shadow: 0 8px 18px rgba(109, 46, 242, 0.4);
}

.engagement-item strong {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.engagement-item.active .icon {
  background: linear-gradient(180deg, #8a40ff 0%, #5a20d0 100%);
}

.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 22px;
  padding: 12px 10px 8px;
  border-top: 1px solid rgba(73, 45, 109, 0.18);
}

.bottom-toolbar button {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #4e3d63;
  background: rgba(255, 255, 255, 0.32);
  font-size: 1.7rem;
  box-shadow: inset 0 0 0 1px rgba(72, 54, 111, 0.08);
}

.bottom-toolbar button.active {
  background: linear-gradient(180deg, #8d4bff 0%, #5d28f5 100%);
  color: white;
  box-shadow: 0 10px 18px rgba(107, 55, 247, 0.38);
}

.side-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180px;
  min-height: 200px;
}

.mini-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 100px;
}

.mini-stat {
  display: flex;
  align-items: center;
  gap: 12px;
  color: white;
  opacity: 0.9;
}

.mini-stat span {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.mini-stat strong {
  font-size: 1.05rem;
  font-weight: 700;
}

.mini-stat.active span {
  background: linear-gradient(180deg, #a86cff 0%, #6c2df7 100%);
}

.bottom-tag {
  margin-top: 28px;
  padding: 18px 105px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.1);
  color: #f3f3f3;
  letter-spacing: 0.05em;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 1.02rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

@media (max-width: 860px) {
  .app-stage {
    gap: 0;
  }

  .side-panel {
    display: none;
  }

  .hidden-mobile {
    display: block;
  }
}

@media (max-width: 560px) {
  .page-shell {
    padding-left: 14px;
    padding-right: 14px;
  }

  .topbar {
    width: 100%;
  }

  .phone-mockup {
    width: min(100%, 360px);
    min-height: 670px;
    padding: 10px 8px 12px;
  }

  .hero-card {
    margin-left: 10px;
    margin-right: 10px;
  }

  .media-panel {
    height: 410px;
  }

  .portrait-bubble {
    width: 168px;
    height: 168px;
  }

  .tab-nav {
    gap: 18px;
  }

  .bottom-tag {
    padding-left: 32px;
    padding-right: 32px;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
}
